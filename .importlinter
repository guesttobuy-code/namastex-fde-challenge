; Contrato de fronteira entre camadas (issue #4 / âncora #3, seção 4).
; Literal ao texto da issue: "dominio não importa aplicacao, infra nem interfaces;
; infra não importa interfaces". Nenhuma restrição além dessas duas foi inferida.

[importlinter]
root_packages =
    dominio
    aplicacao
    infra
    interfaces

[importlinter:contract:dominio-nao-importa-nada-de-fora]
name = dominio não importa aplicacao, infra nem interfaces
type = forbidden
source_modules =
    dominio
forbidden_modules =
    aplicacao
    infra
    interfaces

[importlinter:contract:infra-nao-importa-interfaces]
name = infra não importa interfaces
type = forbidden
source_modules =
    infra
forbidden_modules =
    interfaces
