# Python
__pycache__/
*.py[cod]
.venv/
venv/
.uv/
*.egg-info/

# env / secrets (NUNCA commitar)
.env
.env.*
*.key
*.pem

# OS / editores
.DS_Store
.idea/
.vscode/
*.log

# ...mas os logs de IA são entregável — ver README (Transparência de uso de IA)
!ai-logs/**

# Área local — NADA daqui vai para o GitHub (ver _local/LEIA-ME.md)
_local/
_PRIVADO/
*.token

# Exceções conscientes ao que está ignorado acima
# .env.example documenta as variáveis SEM segredo, e a regra `.env.*` o engoliria
!.env.example
# o log de uma execução completa é entregável do desafio, e a regra `*.log` o engoliria
!examples/*.log
