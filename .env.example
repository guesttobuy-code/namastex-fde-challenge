# issue #9 (F6) — nomes das variáveis, sem valor. O dono cria o .env real com os valores, na raiz
# da worktree da frente. Nenhum chat lê o .env, nem para conferir.

# Provedor do PortalDeLinguagem: "deterministico" (padrão, sem chave/rede) ou "openrouter". Sem
# esta linha (ou em branco), o agente responde objeção de preço com o texto fixo de fora de
# escopo — para a IA de verdade responder (issue #58/#78), preencha com o valor literal abaixo.
# LLM_PROVEDOR=openrouter
LLM_PROVEDOR=

# Obrigatória só quando LLM_PROVEDOR=openrouter. Sem ela, e com openrouter pedido, o adaptador
# falha alto (nunca cai pro determinístico em silêncio) — issue #81: isto vale também dentro do
# docker compose (o `.env` da raiz do host é repassado ao container `app` via `env_file`, nunca
# entra na imagem).
OPENROUTER_API_KEY=

# Id do modelo na lista pública do OpenRouter. Padrão em código: deepseek/deepseek-chat-v3.1
# (ADR-0003) — só preencha para trocar.
LLM_MODELO=
